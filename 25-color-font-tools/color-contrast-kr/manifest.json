{
  "manifest_version": 3,
  "name": "글자색 대비 검사기 (WCAG)",
  "version": "1.0.0",
  "description": "글자색과 배경색의 명도 대비를 계산해 읽기 편한지(WCAG AA·AAA) 알려 주고, 기준을 넘는 가까운 색을 제안합니다.",
  "action": { "default_popup": "popup.html", "default_title": "글자색 대비 검사기" },
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
