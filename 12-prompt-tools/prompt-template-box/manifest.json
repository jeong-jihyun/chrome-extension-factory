{
  "manifest_version": 3,
  "name": "프롬프트 템플릿 상자",
  "version": "1.0.0",
  "description": "{{변수}}가 들어간 프롬프트를 저장해 두고, 빈칸만 채워 복사합니다. 어떤 AI 서비스에서도 쓸 수 있고 데이터는 내 브라우저에만 저장됩니다.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "프롬프트 템플릿 상자",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
