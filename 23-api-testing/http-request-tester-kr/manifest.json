{
  "manifest_version": 3,
  "name": "HTTP 요청 시험기 (한글)",
  "version": "1.0.0",
  "description": "주소·헤더·본문을 넣고 요청을 보내 응답 상태, 시간, 본문을 한글 화면으로 확인합니다.",
  "action": { "default_popup": "popup.html", "default_title": "HTTP 요청 시험기" },
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
