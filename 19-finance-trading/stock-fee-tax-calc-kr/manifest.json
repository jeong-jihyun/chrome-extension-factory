{
  "manifest_version": 3,
  "name": "주식 수수료·세금 손익 계산기",
  "version": "1.0.0",
  "description": "매수가·매도가·수량과 수수료·거래세를 넣으면 실제로 손에 남는 순손익과 손익분기 매도가를 계산합니다. 세율은 직접 고칠 수 있습니다. 계정·서버 없음.",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "수수료·세금 손익 계산",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  }
}
