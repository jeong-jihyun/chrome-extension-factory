{
  "manifest_version": 3,
  "name": "영문 약어 한글 풀이",
  "version": "1.0.0",
  "description": "페이지의 PER, ETF, API, KPI 같은 영문 약어에 마우스를 올리면 한글 이름과 쉬운 설명을 보여 줍니다. 내 용어도 추가할 수 있고, 서버로 아무것도 보내지 않습니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "약어 풀이",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
