{
  "manifest_version": 3,
  "name": "단위가격 비교 계산기",
  "version": "1.0.0",
  "description": "가격·용량·개수를 넣으면 100g당·100ml당·1개당 가격을 계산해 가장 싼 상품을 알려 줍니다. 계정·서버 없음.",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "단위가격 비교",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  }
}
