{
  "manifest_version": 3,
  "name": "영어 단어 상자",
  "version": "1.0.0",
  "description": "웹에서 모르는 영어 단어를 드래그해 우클릭 한 번으로 예문과 함께 담고, 간격을 두고 복습합니다. 계정과 서버 없이 내 브라우저에만 저장됩니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "단어 상자",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
