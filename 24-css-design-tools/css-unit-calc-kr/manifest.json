{
  "manifest_version": 3,
  "name": "CSS 단위·clamp 계산기",
  "version": "1.0.0",
  "description": "px·rem·em·vw 단위를 바꿔 주고, 화면 크기에 따라 부드럽게 변하는 clamp() 글자 크기 값을 만들어 줍니다.",
  "action": { "default_popup": "popup.html", "default_title": "CSS 단위·clamp 계산기" },
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
