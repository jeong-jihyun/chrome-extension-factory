{
  "manifest_version": 3,
  "name": "버그 신고 환경 정보 모으기",
  "version": "1.0.0",
  "description": "버그를 신고할 때 필요한 주소·브라우저·화면 크기 정보를 한글 양식으로 모아 복사합니다.",
  "action": { "default_popup": "popup.html", "default_title": "버그 신고 환경 정보" },
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
