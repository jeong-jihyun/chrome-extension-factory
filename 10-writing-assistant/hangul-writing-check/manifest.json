{
  "manifest_version": 3,
  "name": "한글 글쓰기 점검기",
  "version": "1.0.0",
  "description": "한국어 글의 긴 문장, 같은 끝말·접속어 반복, 군더더기 표현, 이중 피동을 규칙으로 찾아 알려 줍니다. 글이 서버로 나가지 않고 브라우저 안에서만 검사합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "글쓰기 점검",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
